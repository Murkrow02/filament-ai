{
    "name": "murkrow/filament-ai",
    "description": "AI agents and a grounded knowledge base for Filament panels: resource-derived tools, retrieval with citations, native chat, metrics and an MCP server.",
    "keywords": [
        "laravel",
        "rag",
        "llm",
        "embeddings",
        "pgvector",
        "mcp",
        "filament",
        "vector-search"
    ],
    "homepage": "https://github.com/Murkrow02/filament-ai",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Coppola"
        }
    ],
    "support": {
        "issues": "https://github.com/Murkrow02/filament-ai/issues",
        "source": "https://github.com/Murkrow02/filament-ai"
    },
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/bus": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/session": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "laravel/ai": "^0.11",
        "pgvector/pgvector": "^0.2",
        "prism-php/prism": "^0.100"
    },
    "require-dev": {
        "laravel/mcp": "^1.0",
        "laravel/scout": "^10.4|^11.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "suggest": {
        "laravel/mcp": "Required to expose the knowledge base to MCP clients.",
        "laravel/scout": "Enables the 'scout' hybrid lexical retrieval driver.",
        "yethee/tiktoken": "Enables exact BPE token counting instead of the heuristic estimator."
    },
    "autoload": {
        "psr-4": {
            "Murkrow\\FilamentAi\\": "src/",
            "Murkrow\\FilamentAi\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Murkrow\\FilamentAi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:pgvector": "pest --testsuite=Pgvector"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Murkrow\\FilamentAi\\FilamentAiServiceProvider"
            ],
            "aliases": {
                "FilamentAi": "Murkrow\\FilamentAi\\Facades\\FilamentAi"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
